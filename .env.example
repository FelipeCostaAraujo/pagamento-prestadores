# Copy to .env and adjust. Consumed by the Go API (cmd/api).

# Postgres connection string.
# Matches docker-compose.yml, which publishes Postgres on host port 5433
# to avoid clashing with a local Postgres already on 5432.
DIARIAS_DATABASE_URL=postgres://diarias:diarias@localhost:5433/diarias?sslmode=disable

# Listen address for the HTTP API.
DIARIAS_ADDR=:8080

# Optional shared secret. When set, every /api request must send
# `Authorization: Bearer <token>`. Leave empty to disable (local dev only).
DIARIAS_API_TOKEN=

# Comma-separated allowed CORS origins, or * for any. Needed when running
# the Flutter app on Flutter Web.
DIARIAS_CORS_ORIGINS=*

# Seed the design's two demo prestadoras (Marina, Cleide) on an *empty*
# providers table. Off by default: this database now holds real data, and a
# fresh volume (docker compose down -v) would otherwise resurrect the demo
# names. Only ever fires when the table has zero rows.
DIARIAS_SEED=false
