# Copy to .env and adjust. Read by docker compose and by the Go API.
# .env is gitignored — never commit real secrets.

# ---------------------------------------------------------------- database --

# Postgres password. Required by docker compose; it refuses to start without it.
# Use only letters and digits, or URL-encode it: this value is substituted into
# a connection URL, where @ : / ? # have meaning.
POSTGRES_PASSWORD=troque-esta-senha

# Connection string for running the API from source (outside Docker), against
# the port docker-compose.dev.yml publishes.
DIARIAS_DATABASE_URL=postgres://diarias:troque-esta-senha@localhost:5433/diarias?sslmode=disable

# --------------------------------------------------------------------- api --

# Listen address. The container uses :8081 and production compose maps it to
# host port 7000.
DIARIAS_ADDR=:8080

# Trust X-Forwarded-For / X-Real-IP when identifying the client.
# Turn on ONLY behind a reverse proxy: otherwise any caller can forge the header
# and evade login throttling. Off for local development.
DIARIAS_TRUST_PROXY=false

# Comma-separated allowed CORS origins, or * for any. Only matters for a browser
# build; native apps ignore it.
DIARIAS_CORS_ORIGINS=*

# Seed the design's two demo prestadoras (Marina, Cleide) on an *empty*
# providers table. Off by default so a fresh volume never resurrects demo names
# over real data.
DIARIAS_SEED=false

# --------------------------------------------------------------- lembretes --

# Caminho, dentro do container, do JSON da service account do Firebase.
# É o segredo que autoriza enviar push. Gere no console do Firebase em
# Configurações do projeto -> Contas de serviço -> Gerar nova chave privada.
# Vazio desliga os lembretes; a API continua funcionando normalmente.
DIARIAS_FCM_CREDENTIALS=/run/secrets/fcm.json

# Fuso em que "19h" e "dia 5" são interpretados. Nunca o do servidor.
DIARIAS_TIMEZONE=America/Sao_Paulo

# Dia do mês do lembrete de pagamento (1 a 28).
DIARIAS_PAYMENT_REMINDER_DAY=5

# ------------------------------------------------------------------ notes --
#
# There is no API-wide shared token any more: access is username/password.
# Create accounts on the server, there is no public signup:
#
#   docker compose exec api /api user add felipe
#   docker compose exec api /api user list
