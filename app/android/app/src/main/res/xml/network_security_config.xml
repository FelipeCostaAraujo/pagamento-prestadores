<?xml version="1.0" encoding="utf-8"?>
<!--
  Android blocks cleartext HTTP by default (API 28+).

  Production is HTTPS (colaboradores.fca.dev.br) and needs no exception here.
  The entries below exist only so a debug build can talk to the API over plain
  HTTP on the local network. Scoped to specific hosts rather than flipping
  android:usesCleartextTraffic="true", which would weaken every connection the
  app makes.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- The VM on the LAN. -->
        <domain includeSubdomains="false">192.168.10.180</domain>
        <!-- The dev Mac on the LAN, for running the API from source. Both
             machines are on DHCP, so these need updating if a lease changes. -->
        <domain includeSubdomains="false">192.168.10.27</domain>
        <domain includeSubdomains="false">192.168.10.26</domain>
        <!-- The host machine as seen from the Android emulator. -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
